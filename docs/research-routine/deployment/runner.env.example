# Non-secret configuration. Replace both placeholders before use.
# The host's authenticated Codex CLI must support this verified model ID and Ultra.
ANTIMATTER_CODEX_MODEL=REPLACE_WITH_VERIFIED_GPT_6_1_SOL_MODEL_ID
MAX_ROUNDS=0
# Include the actual directory containing the codex executable.
PATH=/ABSOLUTE_PATH_TO_CHECKOUT/.venv/bin:/ABSOLUTE_DIRECTORY_CONTAINING_CODEX:/usr/local/bin:/usr/bin:/bin
